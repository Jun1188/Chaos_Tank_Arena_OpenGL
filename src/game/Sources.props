<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 변준영 담당. 새 파일은 다음 형식으로 이 ItemGroup에 등록한다.
       <ClCompile Include="$(MSBuildThisFileDirectory)Example.cpp" />
       <ClInclude Include="$(MSBuildThisFileDirectory)Example.h" />
  -->
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)ArenaScene.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Physics.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)TankEntity.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)TimeManager.cpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)ArenaScene.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Physics.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)TankEntity.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)TimeManager.h" />
  </ItemGroup>
</Project>
